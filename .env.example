# ─────────────────────────────────────────────────────────────────────────────
# Proveedor: FLAG DE DESPLIEGUE, no una opción del usuario final.
# Perfil por defecto del código: anthropic. La demo en vivo usa el CLI.
# Perfiles: gemini | anthropic | claude_code | antigravity | hybrid | fake
# ─────────────────────────────────────────────────────────────────────────────
LLM_PROVIDER=claude_code

# --- credenciales (solo la del perfil activo) ---
ANTHROPIC_API_KEY=           # console.anthropic.com/settings/keys — perfil `anthropic`
# GOOGLE_API_KEY=            # solo si se reactiva el perfil gemini

# --- CLIs agénticos (perfiles claude_code / antigravity) ---
CLI_TIMEOUT_S=180            # el CLI es lento: no bajar de 120
CLI_DELEGATE_MCP=0           # 0 = el harness ejecuta las tools y conserva la traza

# --- generación ---
TEMPERATURE=0.2
UI_TEMPERATURE=0.4
MAX_OUTPUT_TOKENS=4096

# --- presupuestos ---
MAX_TOOL_STEPS=6
MAX_COMPONENTS=24

# --- producto ---
DOMAIN=educacion_financiera  # ÚNICO dominio con servidor MCP en este repo
SURFACE_ID=main

# --- infra ---
CORS_ORIGINS=*
SESSION_BACKEND=memory       # memory | redis
# REDIS_URL=redis://redis:6379/0

# --- acceso a la demo (código compartido, NO HTTP Basic Auth) ---
# Vacío = sin auth (default, así se queda en dev local). En Railway, ponerla
# protege /v1/turn, /v1/session y el WebSocket (lo que cuesta cuota) — el
# frontend pide el código una vez con su propia pantalla y lo manda por
# header/query, nada de popup nativo del navegador (no porta a WebView de
# app móvil). Ver src/harness/auth.py.
# APP_KEY=cambia-esto-por-algo-random
