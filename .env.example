# ─────────────────────────────────────────────────────────────────────────────
# Proveedor: FLAG DE DESPLIEGUE, no una opción del usuario final.
# El default vive en src/harness/config.py (DEFAULT_PROFILE). Esto lo sobreescribe
# para CI y contenedores. Perfiles: gemini | anthropic | claude_code | antigravity
#                                   | hybrid | fake
# ─────────────────────────────────────────────────────────────────────────────
LLM_PROVIDER=gemini

# --- credenciales (solo la del perfil activo) ---
GOOGLE_API_KEY=              # aistudio.google.com/apikey
ANTHROPIC_API_KEY=           # console.anthropic.com/settings/keys

# --- overrides puntuales de modelo (opcionales) ---
# REASONING_MODEL=gemini-2.5-pro
# UI_MODEL=gemini-2.5-flash

# --- CLIs agénticos (perfiles claude_code / antigravity) ---
# CLI_BINARY=                # ruta al binario si no está en el PATH
CLI_TIMEOUT_S=180
CLI_DELEGATE_MCP=0           # 1: el CLI ejecuta el MCP (pierdes la traza intermedia)
# CLI_MCP_CONFIG=mcp_servers.cli.json
# CLI_EXTRA_ARGS=--dangerously-skip-permissions

# --- generación ---
TEMPERATURE=0.2
UI_TEMPERATURE=0.4
MAX_OUTPUT_TOKENS=4096

# --- presupuestos ---
MAX_TOOL_STEPS=6
MAX_COMPONENTS=24

# --- producto ---
DOMAIN=credito
SURFACE_ID=main

# --- infra ---
CORS_ORIGINS=*
SESSION_BACKEND=memory       # memory | redis
# REDIS_URL=redis://redis:6379/0
# MCP_SERVERS={"servers":[{"name":"credito","transport":"http","url":"http://mcp-credito:8081/mcp"}]}
